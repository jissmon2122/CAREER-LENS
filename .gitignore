.env
.env.*
!.env.example

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
frontend/dist/
frontend/dist-ssr/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files & Logs
.DS_Store
Thumbs.db
*.log

# User Uploaded Files & Temporary Test PDFs (preserve directory structure with .gitkeep)
backend/uploads/resumes/*.pdf
!backend/uploads/resumes/.gitkeep
backend/test_pdfs/*.pdf
backend/test_ocr_pdfs/*.pdf
