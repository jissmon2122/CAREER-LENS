FLASK_ENV=production
FLASK_APP=wsgi.py
SECRET_KEY=career_intelligence_secret_key_change_in_production
JWT_SECRET_KEY=career_jwt_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/career_intelligence?retryWrites=true&w=majority
DATABASE_NAME=career_intelligence
UPLOAD_FOLDER=uploads/resumes
MAX_FILE_SIZE=5242880
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# PRODUCTION CORS & DEPLOYMENT URLS
FRONTEND_URL=https://your-frontend-app.vercel.app
CORS_ORIGINS=https://your-frontend-app.vercel.app

# LIVE JOB PROVIDERS (Adzuna, Jooble, IndianAPI)
JOB_API_PROVIDERS=adzuna,jooble,indianapi
LIVE_JOB_CACHE_TTL=21600
LIVE_JOB_MAX_AGE_DAYS=30

# 1. Adzuna API
ADZUNA_ENABLED=true
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES=2
ADZUNA_TIMEOUT=10

# 2. Jooble REST API
JOOBLE_ENABLED=true
JOOBLE_API_KEY=your_jooble_api_key
JOOBLE_BASE_URL=https://in.jooble.org/api/
JOOBLE_RESULTS_PER_PAGE=50
JOOBLE_MAX_PAGES=2
JOOBLE_TIMEOUT=10

# 3. IndianAPI Jobs API
INDIANAPI_ENABLED=true
INDIANAPI_API_KEY=your_indianapi_key
INDIANAPI_BASE_URL=https://jobs.indianapi.in
INDIANAPI_RESULTS_LIMIT=50
INDIANAPI_TIMEOUT=10
